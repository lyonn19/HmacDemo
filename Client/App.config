<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!-- Must be the SAME secret as in the server's App.config -->
    <add key="HmacSecret" value="change-me-to-a-long-random-secret" />
  </appSettings>

  <system.serviceModel>
    <client>
      <endpoint address="http://localhost:8733/Design_Time_Addresses/OrderService/"
                binding="basicHttpBinding"
                contract="HmacDemo.IOrderService" />
    </client>
  </system.serviceModel>

</configuration>
